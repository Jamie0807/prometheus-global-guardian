# Mapbox Configuration
# Get your free token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# DisasterAware API Configuration (Optional)
# These credentials are optional. The app will work with public data sources (USGS, NASA, GDACS)
VITE_USERNAME=your_username_here
VITE_PASSWORD=your_password_here

# Python Analytics Service (Optional)
VITE_PYTHON_API_URL=http://localhost:8001

# AI Assistant - Volcengine Ark / 火山方舟 (Optional)
# Configure both values to enable the real LLM assistant. Leave empty for Demo mode.
VITE_VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here
VITE_VOLCENGINE_ARK_MODEL=your_ark_model_or_endpoint_id_here
VITE_VOLCENGINE_ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
