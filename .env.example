# Mapbox Configuration
# Get your free token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
# Browser log threshold: debug, info, warn, error, or silent. Changing this requires a rebuild.
VITE_LOG_LEVEL=

# PostgreSQL (Compose uses these defaults for local-only development)
DATABASE_URL=postgresql://prometheus:prometheus@db:5432/prometheus?schema=public
POSTGRES_DB=prometheus
POSTGRES_USER=prometheus
POSTGRES_PASSWORD=prometheus
# Required outside local development. Generate with: openssl rand -base64 48
AUTH_CSRF_SECRET=replace_with_random_secret_at_least_32_characters
# Optional externally visible origin for TLS-terminating reverse proxies, e.g. https://guardian.example.com
PUBLIC_ORIGIN=
AUTH_SESSION_IDLE_TTL_MS=1800000
AUTH_SESSION_ABSOLUTE_TTL_MS=604800000
BFF_REGISTER_RATE_LIMIT_MAX=5
BFF_LOGIN_RATE_LIMIT_MAX=10

# DisasterAware API Configuration (Optional, server-side)
# These credentials are read by the Express BFF, never by browser assets.
DISASTERAWARE_USERNAME=your_username_here
DISASTERAWARE_PASSWORD=your_password_here
# BFF proxy timeout and fixed-window limits (per process, per 60 seconds)
DISASTERAWARE_REQUEST_TIMEOUT_MS=10000
BFF_AUTHORIZE_RATE_LIMIT_MAX=10
BFF_AI_RATE_LIMIT_MAX=30
BFF_HAZARD_RATE_LIMIT_MAX=120
# AI SSE 断连恢复仅使用单实例短时内存会话，以下为默认上限
BFF_AI_STREAM_RESUME_TTL_MS=30000
BFF_AI_STREAM_RESUME_MAX_EVENTS=256
BFF_AI_STREAM_RESUME_MAX_BYTES=524288
BFF_AI_STREAM_RESUME_MAX_SESSIONS=100
# BFF log threshold. Production defaults to info; other environments default to debug.
LOG_LEVEL=

# Python Analytics Service (Optional)
# Docker Compose routes analytics requests through the authenticated BFF over its private network.
ANALYTICS_SERVICE_URL=http://analytics:8001
ANALYTICS_SERVICE_TOKEN=replace_with_a_random_service_secret
# Python analytics management routes are disabled until this server-side token is configured.
ANALYTICS_ADMIN_TOKEN=
# Optional comma-separated CORS origin override for Python Analytics.
ANALYTICS_CORS_ORIGINS=
# Python analytics environment and log threshold. Production defaults to info; other environments default to debug.
APP_ENV=production

# Optional 3D Tiles configuration (public browser-side values)
VITE_3D_TILES_URL=
VITE_CESIUM_ION_TOKEN=

# AI Assistant (Optional, server-side)
# These values are read by the Express BFF at runtime. Do not prefix secrets with VITE_.
# Use "router" for smart routing, or "workflow" / "ark" to force one provider.
AI_PROVIDER=router

# Published ai-workflow app / 已发布工作流
# For Docker on macOS, use http://host.docker.internal:3100/api/v1/apps/run if the workflow runs on the host.
VOLCENGINE_WORKFLOW_API_URL=http://localhost:3100/api/v1/apps/run
VOLCENGINE_WORKFLOW_API_KEY=

# Volcengine Ark model / 火山方舟模型
VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here
VOLCENGINE_ARK_MODEL=ark-code-latest
VOLCENGINE_ARK_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VOLCENGINE_ARK_TIMEOUT_MS=30000
