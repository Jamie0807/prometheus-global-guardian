{
  "name": "prometheus-global-guardian",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "./scripts/with-node-version.sh vite",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "./scripts/with-node-version.sh vite build",
    "build:server": "./scripts/with-node-version.sh tsc -p tsconfig.server.json",
    "build:server:test": "./scripts/with-node-version.sh tsc -p tsconfig.server.test.json",
    "commit": "git-cz",
    "format:check": "./scripts/with-node-version.sh prettier --check README.md python-analytics-service/README.md package.json docs/TESTING_BASELINE.md docs/PROJECT_OPTIMIZATION_BACKLOG.md src/features src/services src/utils/aiAssistant.ts tests/service-*.test.ts tests/server-auth.test.ts tests/request-boundaries.test.ts server/security tests/component tests/e2e vitest.config.ts vitest.component.config.ts playwright.config.ts server.ts AGENTS.md commitlint.config.cjs .prettierrc.json",
    "lint": "./scripts/with-node-version.sh eslint .",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "test": "pnpm run test:unit",
    "test:bff": "pnpm run build:server:test && ./scripts/with-node-version.sh node --test dist-server/tests/ai-provider.test.js dist-server/tests/ai-router.test.js dist-server/tests/ai-stream.test.js dist-server/tests/server-auth.test.js dist-server/tests/request-boundaries.test.js",
    "test:unit": "pnpm run test:bff && pnpm run test:services",
    "test:component": "./scripts/with-node-version.sh vitest run --config vitest.component.config.ts",
    "test:e2e": "./scripts/with-node-version.sh playwright test",
    "test:python": "cd python-analytics-service && python -m unittest discover -s tests -p 'test_*.py'",
    "test:baseline": "pnpm run lint && pnpm run format:check && pnpm run typecheck:client && pnpm run typecheck:server && pnpm run test:unit && pnpm run test:component && pnpm run test:e2e && pnpm run build",
    "test:services": "./scripts/with-node-version.sh vitest run",
    "typecheck:client": "./scripts/with-node-version.sh tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "./scripts/with-node-version.sh tsc --noEmit -p tsconfig.server.json",
    "preview": "./scripts/with-node-version.sh vite preview",
    "start": "./scripts/with-node-version.sh node dist-server/server.js",
    "start:static": "./scripts/with-node-version.sh serve -s dist -l $PORT",
    "node:version": "./scripts/with-node-version.sh node --version"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.10",
    "@deck.gl/extensions": "^9.2.10",
    "@deck.gl/geo-layers": "^9.2.10",
    "@deck.gl/layers": "^9.2.10",
    "@deck.gl/mapbox": "^9.2.10",
    "@deck.gl/mesh-layers": "^9.2.10",
    "@loaders.gl/3d-tiles": "^4.3.4",
    "@loaders.gl/core": "^4.3.4",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.5",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.15.0",
    "node-fetch": "^3.3.2",
    "raw-body": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.4",
    "recharts": "^3.5.0",
    "serve": "^14.2.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@vitejs/plugin-react": "^5.0.4",
    "commitizen": "4.3.1",
    "cz-git": "1.10.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,js,cjs,mjs,json,md,yaml,yml}": "prettier --write"
  }
}
