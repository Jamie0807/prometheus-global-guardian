{
  "name": "prometheus-global-guardian",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:server:test": "tsc -p tsconfig.server.test.json",
    "lint": "eslint .",
    "test": "npm run build:server:test && node --test dist-server/tests/*.test.js",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist-server/server.js",
    "start:static": "serve -s dist -l $PORT"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.10",
    "@deck.gl/extensions": "^9.2.10",
    "@deck.gl/geo-layers": "^9.2.10",
    "@deck.gl/layers": "^9.2.10",
    "@deck.gl/mapbox": "^9.2.10",
    "@deck.gl/mesh-layers": "^9.2.10",
    "@loaders.gl/3d-tiles": "^4.3.4",
    "@loaders.gl/core": "^4.3.4",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.5",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "mapbox-gl": "^3.15.0",
    "node-fetch": "^3.3.2",
    "raw-body": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-is": "^19.2.4",
    "recharts": "^3.5.0",
    "serve": "^14.2.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
